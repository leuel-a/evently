{
  "name": "@evently/models",
  "version": "0.1.0",
  "description": "Shared Models for the Evently Platform",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "exports": {
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./eventsCategory": {
      "types": "./dist/eventsCategory/index.d.ts",
      "default": "./dist/eventsCategory/index.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "default": "./dist/accounts/index.js"
    },
    "./tickets": {
      "types": "./dist/tickets/index.d.ts",
      "default": "./dist/tickets/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "default": "./dist/resources/index.js"
    }
 },
  "author": "github.com/leuel-a",
  "packageManager": "npm@24.16.0",
  "dependencies": {
    "mongoose": "8.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
