        "turbo": "^2.8.13",
        "typescript": "5.9.2"
    },
    "engines": { "node": ">=18" },
    "packageManager": "npm@24.16.0",
    "dependencies": {
        "@better-auth/mongo-adapter": "^1.5.4",
        "mongoose": "^8.23.0"
    }
}
