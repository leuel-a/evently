{
    "name": "evently",
    "private": true,
    "workspaces": [ "apps/*", "packages/*" ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "test": "turbo run test",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
